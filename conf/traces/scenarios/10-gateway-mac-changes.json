{
  "name": "gateway-mac-changes",
  "description": "The core gateway's MAC changes (RTM_NEWNEIGH with a new lladdr): frames to it, by its host route or by the default route, must carry the new MAC",
  "interfaces": [
    "access",
    "core"
  ],
  "kernel": {
    "links": {
      "1": "lo",
      "2": "access",
      "3": "core"
    },
    "neighbors": [
      {
        "dst": "10.1.0.1",
        "lladdr": "aa:bb:cc:00:00:01",
        "ifindex": 2
      },
      {
        "dst": "10.2.0.1",
        "lladdr": "aa:bb:cc:00:00:02",
        "ifindex": 3
      }
    ],
    "routes": [
      {
        "dst": "10.1.0.0/24",
        "oif": 2
      },
      {
        "dst": "10.1.0.2/32",
        "oif": 2,
        "table": 255,
        "type": 2,
        "scope": 254
      },
      {
        "dst": "10.1.0.255/32",
        "oif": 2,
        "table": 255,
        "type": 3,
        "scope": 253
      },
      {
        "dst": "10.2.0.0/24",
        "oif": 3
      },
      {
        "dst": "10.2.0.2/32",
        "oif": 3,
        "table": 255,
        "type": 2,
        "scope": 254
      },
      {
        "dst": "10.2.0.255/32",
        "oif": 3,
        "table": 255,
        "type": 3,
        "scope": 253
      },
      {
        "dst": "10.100.0.0/16",
        "gw": "10.1.0.1",
        "oif": 2
      },
      {
        "dst": "0.0.0.0/0",
        "gw": "10.2.0.1",
        "oif": 3
      }
    ]
  },
  "steps": [
    {
      "start": true
    },
    {
      "expect": [
        [
          "module_command",
          "accessRoutes",
          "add",
          {
            "prefix": "10.1.0.1",
            "prefix_len": 32,
            "gate": 0
          }
        ],
        [
          "create_module",
          "accessDstMACAABBCC000001",
          "Update",
          {
            "dst_mac": "aa:bb:cc:00:00:01"
          }
        ],
        [
          "connect",
          "accessRoutes",
          0,
          "accessDstMACAABBCC000001",
          0
        ],
        [
          "connect",
          "accessDstMACAABBCC000001",
          0,
          "accessMerge",
          0
        ],
        [
          "module_command",
          "accessRoutes",
          "add",
          {
            "prefix": "10.100.0.0",
            "prefix_len": 16,
            "gate": 0
          }
        ],
        [
          "module_command",
          "coreRoutes",
          "add",
          {
            "prefix": "10.2.0.1",
            "prefix_len": 32,
            "gate": 0
          }
        ],
        [
          "create_module",
          "coreDstMACAABBCC000002",
          "Update",
          {
            "dst_mac": "aa:bb:cc:00:00:02"
          }
        ],
        [
          "connect",
          "coreRoutes",
          0,
          "coreDstMACAABBCC000002",
          0
        ],
        [
          "connect",
          "coreDstMACAABBCC000002",
          0,
          "coreMerge",
          0
        ],
        [
          "module_command",
          "coreRoutes",
          "add",
          {
            "prefix": "0.0.0.0",
            "prefix_len": 0,
            "gate": 0
          }
        ]
      ]
    },
    {
      "neigh_change": {
        "dst": "10.2.0.1",
        "lladdr": "aa:bb:cc:00:00:22",
        "ifindex": 3
      }
    },
    {
      "expect": [],
      "allow": [
        [
          "module_command",
          "*",
          "*",
          "*"
        ],
        [
          "module_command",
          "*",
          "*",
          "*"
        ],
        [
          "module_command",
          "*",
          "*",
          "*"
        ],
        [
          "module_command",
          "*",
          "*",
          "*"
        ],
        [
          "create_module",
          "*",
          "Update",
          "*"
        ],
        [
          "connect",
          "*",
          "*",
          "*",
          "*"
        ],
        [
          "connect",
          "*",
          "*",
          "*",
          "*"
        ],
        [
          "destroy_module",
          "*"
        ],
        [
          "disconnect",
          "*",
          "*"
        ]
      ],
      "note": "How the MAC is changed is the implementation's choice; the state below is the requirement."
    },
    {
      "expect_state": {
        "forwarding": {
          "coreRoutes": {
            "0.0.0.0/0": {
              "dst_mac": "aa:bb:cc:00:00:22",
              "to": "coreMerge"
            },
            "10.2.0.1/32": {
              "dst_mac": "aa:bb:cc:00:00:22",
              "to": "coreMerge"
            }
          }
        }
      },
      "expect_state_python": {
        "forwarding": {
          "coreRoutes": {
            "0.0.0.0/0": {
              "dst_mac": "aa:bb:cc:00:00:02",
              "to": "coreMerge"
            },
            "10.2.0.1/32": {
              "dst_mac": "aa:bb:cc:00:00:02",
              "to": "coreMerge"
            }
          }
        }
      },
      "because": "_handle_neighbor_event (route_control.py:1072-1084) acts on a new neighbor only by installing the routes that were waiting for it; a changed lladdr for a programmed next hop is not noticed, so the adjacency keeps stamping the old MAC."
    }
  ],
  "python_differs": true
}

{
  "name": "route-add-refused",
  "description": "bessd refuses to add a prefix (EIO here, five times): the route must be installed once the daemon answers, without 10 s of paused workers meanwhile",
  "interfaces": [
    "access",
    "core"
  ],
  "kernel": {
    "links": {
      "1": "lo",
      "2": "access",
      "3": "core"
    },
    "neighbors": [
      {
        "dst": "10.1.0.1",
        "lladdr": "aa:bb:cc:00:00:01",
        "ifindex": 2
      },
      {
        "dst": "10.2.0.1",
        "lladdr": "aa:bb:cc:00:00:02",
        "ifindex": 3
      }
    ],
    "routes": [
      {
        "dst": "10.1.0.0/24",
        "oif": 2
      },
      {
        "dst": "10.1.0.2/32",
        "oif": 2,
        "table": 255,
        "type": 2,
        "scope": 254
      },
      {
        "dst": "10.1.0.255/32",
        "oif": 2,
        "table": 255,
        "type": 3,
        "scope": 253
      },
      {
        "dst": "10.2.0.0/24",
        "oif": 3
      },
      {
        "dst": "10.2.0.2/32",
        "oif": 3,
        "table": 255,
        "type": 2,
        "scope": 254
      },
      {
        "dst": "10.2.0.255/32",
        "oif": 3,
        "table": 255,
        "type": 3,
        "scope": 253
      },
      {
        "dst": "10.100.0.0/16",
        "gw": "10.1.0.1",
        "oif": 2
      },
      {
        "dst": "0.0.0.0/0",
        "gw": "10.2.0.1",
        "oif": 3
      }
    ]
  },
  "steps": [
    {
      "bess_error": {
        "op": "module_command",
        "code": "EIO",
        "match": {
          "name": "coreRoutes",
          "prefix": "172.16.0.0"
        }
      }
    },
    {
      "bess_error": {
        "op": "module_command",
        "code": "EIO",
        "match": {
          "name": "coreRoutes",
          "prefix": "172.16.0.0"
        }
      }
    },
    {
      "bess_error": {
        "op": "module_command",
        "code": "EIO",
        "match": {
          "name": "coreRoutes",
          "prefix": "172.16.0.0"
        }
      }
    },
    {
      "bess_error": {
        "op": "module_command",
        "code": "EIO",
        "match": {
          "name": "coreRoutes",
          "prefix": "172.16.0.0"
        }
      }
    },
    {
      "bess_error": {
        "op": "module_command",
        "code": "EIO",
        "match": {
          "name": "coreRoutes",
          "prefix": "172.16.0.0"
        }
      }
    },
    {
      "start": true
    },
    {
      "expect": [
        [
          "module_command",
          "accessRoutes",
          "add",
          {
            "prefix": "10.1.0.1",
            "prefix_len": 32,
            "gate": 0
          }
        ],
        [
          "create_module",
          "accessDstMACAABBCC000001",
          "Update",
          {
            "dst_mac": "aa:bb:cc:00:00:01"
          }
        ],
        [
          "connect",
          "accessRoutes",
          0,
          "accessDstMACAABBCC000001",
          0
        ],
        [
          "connect",
          "accessDstMACAABBCC000001",
          0,
          "accessMerge",
          0
        ],
        [
          "module_command",
          "accessRoutes",
          "add",
          {
            "prefix": "10.100.0.0",
            "prefix_len": 16,
            "gate": 0
          }
        ],
        [
          "module_command",
          "coreRoutes",
          "add",
          {
            "prefix": "10.2.0.1",
            "prefix_len": 32,
            "gate": 0
          }
        ],
        [
          "create_module",
          "coreDstMACAABBCC000002",
          "Update",
          {
            "dst_mac": "aa:bb:cc:00:00:02"
          }
        ],
        [
          "connect",
          "coreRoutes",
          0,
          "coreDstMACAABBCC000002",
          0
        ],
        [
          "connect",
          "coreDstMACAABBCC000002",
          0,
          "coreMerge",
          0
        ],
        [
          "module_command",
          "coreRoutes",
          "add",
          {
            "prefix": "0.0.0.0",
            "prefix_len": 0,
            "gate": 0
          }
        ]
      ]
    },
    {
      "route_add": {
        "dst": "172.16.0.0/16",
        "gw": "10.2.0.1",
        "oif": 3
      }
    },
    {
      "expect": [],
      "max_paused_sleep": 0,
      "note": "Five refused adds are not effective; what matters is that the route is not forgotten and the workers are not held.",
      "expect_python": [
        [
          "pause"
        ],
        [
          "module_command",
          "coreRoutes",
          "add",
          {
            "prefix": "172.16.0.0",
            "prefix_len": 16,
            "gate": 0
          }
        ],
        [
          "error",
          "EIO"
        ],
        [
          "sleep",
          2
        ],
        [
          "resume"
        ],
        [
          "pause"
        ],
        [
          "module_command",
          "coreRoutes",
          "add",
          {
            "prefix": "172.16.0.0",
            "prefix_len": 16,
            "gate": 0
          }
        ],
        [
          "error",
          "EIO"
        ],
        [
          "sleep",
          2
        ],
        [
          "resume"
        ],
        [
          "pause"
        ],
        [
          "module_command",
          "coreRoutes",
          "add",
          {
            "prefix": "172.16.0.0",
            "prefix_len": 16,
            "gate": 0
          }
        ],
        [
          "error",
          "EIO"
        ],
        [
          "sleep",
          2
        ],
        [
          "resume"
        ],
        [
          "pause"
        ],
        [
          "module_command",
          "coreRoutes",
          "add",
          {
            "prefix": "172.16.0.0",
            "prefix_len": 16,
            "gate": 0
          }
        ],
        [
          "error",
          "EIO"
        ],
        [
          "sleep",
          2
        ],
        [
          "resume"
        ],
        [
          "pause"
        ],
        [
          "module_command",
          "coreRoutes",
          "add",
          {
            "prefix": "172.16.0.0",
            "prefix_len": 16,
            "gate": 0
          }
        ],
        [
          "error",
          "EIO"
        ],
        [
          "sleep",
          2
        ],
        [
          "resume"
        ]
      ],
      "because": "add_new_route_entry pops the route from the unresolved queue before programming it (route_control.py:443); when add_route_to_module exhausts MAX_RETRIES (five tries, 2 s asleep under pause each) the route is in neither cache, so a later neighbor event does nothing for it and only a repeated route event installs it."
    },
    {
      "neigh_add": {
        "dst": "10.2.0.1",
        "lladdr": "aa:bb:cc:00:00:02",
        "ifindex": 3
      },
      "note": "The gateway re-announces itself (a kernel neighbor refresh)."
    },
    {
      "expect": [
        [
          "module_command",
          "coreRoutes",
          "add",
          {
            "prefix": "172.16.0.0",
            "prefix_len": 16,
            "gate": 0
          }
        ]
      ],
      "allow": [
        [
          "module_command",
          "coreRoutes",
          "add",
          {
            "prefix": "172.16.0.0",
            "prefix_len": 16,
            "gate": 0
          }
        ]
      ],
      "expect_python": [],
      "because": "add_new_route_entry pops the route from the unresolved queue before programming it (route_control.py:443); when add_route_to_module exhausts MAX_RETRIES (five tries, 2 s asleep under pause each) the route is in neither cache, so a later neighbor event does nothing for it and only a repeated route event installs it."
    },
    {
      "expect_state": {
        "forwarding": {
          "coreRoutes": {
            "0.0.0.0/0": {
              "dst_mac": "aa:bb:cc:00:00:02",
              "to": "coreMerge"
            },
            "10.2.0.1/32": {
              "dst_mac": "aa:bb:cc:00:00:02",
              "to": "coreMerge"
            },
            "172.16.0.0/16": {
              "dst_mac": "aa:bb:cc:00:00:02",
              "to": "coreMerge"
            }
          }
        }
      },
      "expect_state_python": {
        "forwarding": {
          "coreRoutes": {
            "0.0.0.0/0": {
              "dst_mac": "aa:bb:cc:00:00:02",
              "to": "coreMerge"
            },
            "10.2.0.1/32": {
              "dst_mac": "aa:bb:cc:00:00:02",
              "to": "coreMerge"
            }
          }
        }
      },
      "because": "add_new_route_entry pops the route from the unresolved queue before programming it (route_control.py:443); when add_route_to_module exhausts MAX_RETRIES (five tries, 2 s asleep under pause each) the route is in neither cache, so a later neighbor event does nothing for it and only a repeated route event installs it."
    }
  ],
  "python_differs": true
}

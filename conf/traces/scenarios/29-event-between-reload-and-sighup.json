        [
          "module_command",
          "coreRoutes",
          "add",
          {
            "prefix": "0.0.0.0",
            "prefix_len": 0,
            "gate": 0
          }
        ]
      ]
    },
    {
      "bess_reload": true
    },
    {
      "route_del": {
        "dst": "10.100.0.0/16",
        "gw": "10.1.0.1",
        "oif": 2
      }
    },
    {
      "expect": [],
      "max_paused_sleep": 0,
      "note": "The refused delete is not effective; one attempt is fine, five with the workers paused are not.",
      "expect_python": [
        [
          "pause"
        ],
        [
          "module_command",
          "accessRoutes",
          "delete",
          {
            "prefix": "10.100.0.0",
            "prefix_len": 16
          }
        ],
        [
          "error",
          "ENOENT"
        ],
        [
          "sleep",
          2
        ],
        [
          "resume"
        ],
        [
          "pause"
        ],
        [
          "module_command",
          "accessRoutes",
          "delete",
          {
            "prefix": "10.100.0.0",
            "prefix_len": 16
          }
        ],
        [
          "error",
          "ENOENT"
        ],
        [
          "sleep",
          2
        ],
        [
          "resume"
        ],
        [
          "pause"
        ],
        [
          "module_command",
          "accessRoutes",
          "delete",
          {
            "prefix": "10.100.0.0",
            "prefix_len": 16
          }
        ],
        [
          "error",
          "ENOENT"
        ],
        [
          "sleep",
          2
        ],
        [
          "resume"
        ],
        [
          "pause"
        ],
        [
          "module_command",
          "accessRoutes",
          "delete",
          {
            "prefix": "10.100.0.0",
            "prefix_len": 16
          }
        ],
        [
          "error",
          "ENOENT"
        ],
        [
          "sleep",
          2
        ],
        [
          "resume"
        ],
        [
          "pause"
        ],
        [
          "module_command",
          "accessRoutes",
          "delete",
          {
            "prefix": "10.100.0.0",
            "prefix_len": 16
          }
        ],
        [
          "error",
          "ENOENT"
        ],
        [
          "sleep",
          2
        ],
        [
          "resume"
        ]
      ],
      "because": "delete_module_route_entry (route_control.py:163-197) retries any failure five times, 2 s asleep under pause each, including ENOENT for a prefix the daemon no longer has."
    },
    {
      "sighup": true
    },
    {
      "expect": [
        [
          "module_command",
          "accessRoutes",
          "add",
          {
            "prefix": "10.1.0.1",
            "prefix_len": 32,
            "gate": 0

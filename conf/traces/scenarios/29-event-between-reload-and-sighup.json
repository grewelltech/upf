    {
      "expect_state": {
        "forwarding": {
          "accessRoutes": {
            "0.0.0.0/0": "drop",
            "10.1.0.1/32": {
              "dst_mac": "aa:bb:cc:00:00:01",
              "to": "accessMerge"
            }
          },
          "coreRoutes": {
            "0.0.0.0/0": {
              "dst_mac": "aa:bb:cc:00:00:02",
              "to": "coreMerge"
            },
            "10.2.0.1/32": {
              "dst_mac": "aa:bb:cc:00:00:02",
              "to": "coreMerge"
            }
          }
        }

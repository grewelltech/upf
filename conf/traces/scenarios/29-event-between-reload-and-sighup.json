        [
          "create_module",
          "accessDstMACAABBCC000001",
          "Update",
          {
            "dst_mac": "aa:bb:cc:00:00:01"
          }
        ],
        [
          "connect",
          "accessRoutes",
          0,
          "accessDstMACAABBCC000001",
          0
        ],
        [
          "connect",
          "accessDstMACAABBCC000001",
          0,
          "accessMerge",
          0
        ],
        [
          "module_command",
          "coreRoutes",
          "add",
          {
            "prefix": "10.2.0.1",
            "prefix_len": 32,
            "gate": 0
          }
        ],
        [
          "create_module",
          "coreDstMACAABBCC000002",
          "Update",
          {
            "dst_mac": "aa:bb:cc:00:00:02"
          }
        ],
        [
          "connect",
          "coreRoutes",
          0,
          "coreDstMACAABBCC000002",
          0
        ],
        [
          "connect",
          "coreDstMACAABBCC000002",
          0,
          "coreMerge",
          0
        ],
        [
          "module_command",
          "coreRoutes",
          "add",
          {
            "prefix": "0.0.0.0",
            "prefix_len": 0,
            "gate": 0
          }
